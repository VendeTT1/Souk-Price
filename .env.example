# Leave empty to run with the local-storage demo store (data stays in your browser).
# Fill both to use Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Minimum number of distinct entries before an item shows in the dashboard average.
# Use 3 while testing, 10 in production.
VITE_MIN_ENTRIES=3
